# Обов'язково — отримай у @BotFather в Telegram
BOT_TOKEN=your_token_here

# База даних — вибери один варіант:

# Варіант 1: SQLite (для початку, нічого не треба встановлювати)
DATABASE_URL=sqlite+aiosqlite:///./priceguard.db

# Варіант 2: PostgreSQL (коли будеш готовий до production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/priceguard

# Необов'язково (можна залишити за замовчуванням)
FREE_TIER_MAX_ITEMS=5
PREMIUM_PRICE_UAH=99
SCHEDULER_INTERVAL_MINUTES=15

# ─── Адмін-дашборд (python admin.py) ───────────────────────────
# Згенеруй: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_STORAGE_SECRET=
ADMIN_PORT=8088
ADMIN_HOST=127.0.0.1
ADMIN_2FA_ENABLED=true

# ─── JS-рендеринг через Playwright (опційно) ────────────────────
# venv/bin/python -m playwright install chromium
RENDER_MAX_CONCURRENCY=2
RENDER_FALLBACK=true

# ─── Власник і реквізити ────────────────────────────────────────
# Telegram ID власника: адмін-команди в боті, 2FA-коди адмінки, алерти. Дізнатися: @userinfobot
ADMIN_TELEGRAM_ID=
# Картка/IBAN для ручної оплати Premium (показуються юзеру в /premium). Порожньо → оплата "недоступна"
CARD_NUMBER=
CARD_IBAN=

# ─── Експлуатація (python ops.py backup | healthcheck; pm2 запускає за розкладом) ───
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# Копія бекапу поза машиною (rsync), напр. user@nas:/backups/priceguard
BACKUP_REMOTE=
# Зовнішній моніторинг: healthchecks.io або Uptime Kuma (push URL). Порожньо — збої видно лише в logs/ops.out.log
# (у Telegram healthcheck не пише з 14.10)
HEALTHCHECK_PING_URL=
